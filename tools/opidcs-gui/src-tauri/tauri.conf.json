{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "opidcs",
  "version": "1.0.0",
  "identifier": "com.openidcsteam.opidcs",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "opidcs · OpenIDCS 管理台",
        "width": 1320,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "externalBin": ["binaries/opidcs"]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/OpenIDCSTeam/CloudHost/releases/latest/download/latest.json"
      ],
      "pubkey": "REPLACE_WITH_TAURI_UPDATER_PUBKEY"
    }
  }
}
